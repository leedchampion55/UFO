# PostgreSQL application and migration connection strings.
DATABASE_URL="postgresql://ufo@127.0.0.1:55432/ufo_development"
DIRECT_URL="postgresql://ufo@127.0.0.1:55432/ufo_development"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_RUNTIME_MODE="local"
# Optional comma-separated additional exact origins. Leave empty in normal use.
TRUSTED_APP_ORIGINS=""

# Used only to pseudonymise rate-limit keys. Do not reuse the auth secret.
RATE_LIMIT_SECRET="replace-with-another-random-secret"

# Local development trusts the directly supplied X-Real-IP test value. Railway
# production must use "railway" and must not expose the app around its proxy.
TRUSTED_PROXY_MODE="local"

# Private uploads remain outside public/. This may be an absolute path in production.
PRIVATE_MEDIA_ROOT=".data/private-media"
STORAGE_DRIVER="local"

# Development-only verification and password-reset mailbox.
DEV_MAIL_ROOT=".data/dev-mail"
EMAIL_DRIVER="development"

# Production providers. Leave unset while the local drivers above are selected.
# RESEND_API_KEY="re_replace_me"
# RESEND_FROM="What the UFO?! <no-reply@notify.example.com>"
# RESEND_SENDING_DOMAIN="notify.example.com"
# RESEND_WEBHOOK_SECRET="whsec_replace_me"
# ADMIN_NOTIFICATION_EMAIL="matt@example.com"
# R2_ENDPOINT="https://replace-account-id.r2.cloudflarestorage.com"
# R2_BUCKET="what-the-ufo-private-evidence"
# R2_ACCESS_KEY_ID="replace-me"
# R2_SECRET_ACCESS_KEY="replace-me"
R2_REGION="auto"
R2_FORCE_PATH_STYLE="false"

# Database pool settings are per application replica. Keep the combined pool
# below the Neon compute connection allowance.
DATABASE_POOL_MAX="5"
DATABASE_CONNECT_TIMEOUT_MS="5000"
DATABASE_IDLE_TIMEOUT_MS="30000"
DATABASE_APPLICATION_NAME="what-the-ufo-web"

# Operator-only emergency switch. A false value rejects new encounter reports
# before request bodies are parsed; existing data and community access remain.
PUBLIC_SUBMISSIONS_ENABLED="true"

# Optional, privacy-minimised error event receiver. Leave unset locally.
# ERROR_MONITORING_ENDPOINT="https://monitoring.example.com/project/events"
# ERROR_MONITORING_TOKEN="replace-with-provider-token"
# RELEASE_SHA is normally set from RAILWAY_GIT_COMMIT_SHA.

# Evidence backup must use a bucket and credentials distinct from the live R2
# service. Local defaults permit safe drills without cloud access.
MEDIA_BACKUP_DRIVER="local"
MEDIA_BACKUP_ROOT=".data/private-media-backup"
# MEDIA_BACKUP_R2_ENDPOINT="https://replace-account-id.r2.cloudflarestorage.com"
# MEDIA_BACKUP_R2_BUCKET="what-the-ufo-evidence-backup"
# MEDIA_BACKUP_R2_ACCESS_KEY_ID="replace-me"
# MEDIA_BACKUP_R2_SECRET_ACCESS_KEY="replace-me"
# MEDIA_BACKUP_R2_REGION="auto"
# MEDIA_BACKUP_R2_FORCE_PATH_STYLE="false"

# Logical database backups. Supply the passphrase only at execution time.
BACKUP_DESTINATION=".data/backups"
BACKUP_RETENTION_DAYS="30"
# BACKUP_ENCRYPTION_PASSPHRASE="never-commit-this"

# PostgreSQL application and migration connection strings.
DATABASE_URL="postgresql://ufo@127.0.0.1:55432/ufo_development"
DIRECT_URL="postgresql://ufo@127.0.0.1:55432/ufo_development"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_RUNTIME_MODE="local"
# Optional comma-separated additional exact origins. Leave empty in normal use.
TRUSTED_APP_ORIGINS=""

# Used only to pseudonymise rate-limit keys. Do not reuse the auth secret.
RATE_LIMIT_SECRET="replace-with-another-random-secret"

# Local development trusts the directly supplied X-Real-IP test value. Railway
# production must use "railway" and must not expose the app around its proxy.
TRUSTED_PROXY_MODE="local"

# Private uploads remain outside public/. This may be an absolute path in production.
PRIVATE_MEDIA_ROOT=".data/private-media"
STORAGE_DRIVER="local"

# Development-only verification and password-reset mailbox.
DEV_MAIL_ROOT=".data/dev-mail"
EMAIL_DRIVER="development"

# Phase 4C will add the real R2/Resend values. Never put credentials in Git.
# R2_ACCOUNT_ID=""
# R2_BUCKET_NAME=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# RESEND_API_KEY=""

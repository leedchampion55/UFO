generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EncounterStatus {
  DRAFT
  PENDING
  NEEDS_INFORMATION
  PUBLISHED
  REJECTED
  UNPUBLISHED
  DELETED
}

enum MediaType {
  IMAGE
}

enum MediaStorageStatus {
  PENDING_UPLOAD
  READY
  FAILED
  DELETING
  REMOVED
}

enum EmailKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PASSWORD_RESET_SECURITY
  ACCOUNT_SECURITY
  ENCOUNTER_SUBMITTED
  COMMUNITY_REPORT
}

enum EmailOutboxStatus {
  QUEUED
  PROCESSING
  ACCEPTED
  DELIVERED
  FAILED
  DEAD_LETTER
  SUPPRESSED
}

enum ModerationAction {
  SUBMITTED
  CREATED
  UPDATED
  REQUESTED_INFORMATION
  APPROVED
  REJECTED
  PUBLISHED
  UNPUBLISHED
  DELETED
  MEDIA_APPROVED
  MEDIA_REMOVED
}

enum AdministratorRole {
  OWNER
  EDITOR
}

enum CommunityReportReason {
  SPAM
  HARASSMENT
  PERSONAL_INFORMATION
  INAPPROPRIATE_CONTENT
  MISLEADING_OR_IMPERSONATION
  OTHER
}

enum CommunityReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum CommunityTargetType {
  DISCUSSION
  DISCUSSION_REPLY
  ENCOUNTER_COMMENT
  MEMBER
}

enum CommunityModerationAction {
  DISCUSSION_PINNED
  DISCUSSION_UNPINNED
  DISCUSSION_LOCKED
  DISCUSSION_UNLOCKED
  DISCUSSION_REMOVED
  REPLY_REMOVED
  COMMENT_REMOVED
  MEMBER_SUSPENDED
  MEMBER_REINSTATED
  REPORT_RESOLVED
  REPORT_DISMISSED
}

model Category {
  id          String      @id @default(uuid())
  name        String      @unique
  slug        String      @unique
  description String?
  imagePath   String?
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  encounters  Encounter[]

  @@index([active, sortOrder])
}

model Encounter {
  id                    String                @id @default(uuid())
  caseReference         String                @unique
  title                 String
  slug                  String                @unique
  categoryId            String
  category              Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  originalStoryContent  String
  storyContent          String
  summary               String?
  encounterDate         DateTime?
  approximateDate       String?
  approximateTime       String?
  approximateLocation   String?
  region                String?
  witnessCount          Int?
  publicDisplayName     String?
  publishAnonymously    Boolean               @default(false)
  publicationConsent    Boolean
  videoLinks            Json                   @default("[]")
  submittedAt           DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  publishedAt           DateTime?
  status                EncounterStatus        @default(PENDING)
  founderFile           Boolean                @default(false)
  featured              Boolean                @default(false)
  administrativeNotes   String?
  deletedAt             DateTime?
  createdByAdminId      String?
  createdByAdmin        Administrator?         @relation("CreatedEncounters", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  media                 EncounterMedia[]
  contact               SubmissionContact?
  moderationHistory     EncounterModeration[]
  comments              EncounterComment[]

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([founderFile, status, publishedAt])
  @@index([featured, status, publishedAt])
  @@index([submittedAt])
}

model EncounterMedia {
  id                  String         @id @default(uuid())
  encounterId         String
  encounter           Encounter      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  storageKey          String         @unique
  mediaType           MediaType      @default(IMAGE)
  originalFileName    String?
  mimeType            String
  byteSize            Int
  width               Int
  height              Int
  caption             String?
  alternativeText     String?
  uploadedAt          DateTime       @default(now())
  approvedAt          DateTime?
  approvedByAdminId   String?
  approvedByAdmin     Administrator? @relation("ApprovedMedia", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  removedAt           DateTime?
  storageStatus       MediaStorageStatus @default(PENDING_UPLOAD)
  storageAttempts     Int            @default(0)
  storageUpdatedAt    DateTime       @default(now())
  storageEtag         String?
  lastStorageError    String?

  @@index([encounterId, approvedAt, removedAt])
  @@index([storageStatus, storageUpdatedAt])
}

model EmailOutbox {
  id                String            @id @default(uuid())
  kind              EmailKind
  recipient         String
  subject           String
  payload           Json
  status            EmailOutboxStatus @default(QUEUED)
  idempotencyKey    String            @unique
  providerMessageId String?           @unique
  attemptCount      Int               @default(0)
  maxAttempts       Int               @default(5)
  nextAttemptAt     DateTime           @default(now())
  lockedAt          DateTime?
  lockedBy          String?
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  lastErrorCode     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, nextAttemptAt])
  @@index([lockedAt])
  @@index([createdAt])
}

model EmailWebhookEvent {
  id                String   @id @default(uuid())
  providerEventId   String   @unique
  providerMessageId String?
  eventType         String
  processedAt       DateTime @default(now())

  @@index([providerMessageId, processedAt])
}

model EmailSuppression {
  id                String   @id @default(uuid())
  recipientHash     String   @unique
  reason            String
  providerMessageId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdAt])
}

model SubmissionContact {
  id              String    @id @default(uuid())
  encounterId     String    @unique
  encounter       Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  email           String?
  privateName     String?
  removalTokenHash String?   @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model EncounterModeration {
  id               String               @id @default(uuid())
  encounterId      String
  encounter        Encounter            @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  administratorId  String?
  administrator    Administrator?       @relation(fields: [administratorId], references: [id], onDelete: SetNull)
  action           ModerationAction
  previousStatus   EncounterStatus?
  updatedStatus    EncounterStatus?
  reason           String?
  metadata         Json?
  createdAt        DateTime              @default(now())

  @@index([encounterId, createdAt])
  @@index([administratorId, createdAt])
}

model Administrator {
  id                 String                @id @default(uuid())
  userId             String                @unique
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  role               AdministratorRole     @default(EDITOR)
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  moderationActions  EncounterModeration[]
  createdEncounters  Encounter[]           @relation("CreatedEncounters")
  approvedMedia      EncounterMedia[]       @relation("ApprovedMedia")
  communityActions   CommunityModeration[]
  resolvedReports    CommunityReport[]      @relation("ResolvedReports")
}

model RequestRateLimit {
  id          String   @id @default(uuid())
  purpose     String
  keyHash     String
  windowStart DateTime
  requestCount Int     @default(1)
  updatedAt   DateTime @updatedAt

  @@unique([purpose, keyHash, windowStart])
  @@index([purpose, windowStart])
}

// Better Auth core and admin-plugin schema.
model User {
  id            String          @id
  name          String
  email         String          @unique
  emailVerified Boolean         @default(false)
  image         String?
  role          String?         @default("member")
  twoFactorEnabled Boolean      @default(false)
  banned        Boolean?        @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]
  administrator Administrator?
  memberProfile MemberProfile?

  @@map("user")
}

model MemberProfile {
  id               String                @id @default(uuid())
  userId           String                @unique
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  username         String                @unique
  usernameCanonical String               @unique
  displayName      String?
  biography        String?
  joinedAt         DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  suspendedAt      DateTime?
  suspensionReason String?
  discussions      Discussion[]
  discussionReplies DiscussionReply[]
  encounterComments EncounterComment[]
  reports          CommunityReport[]     @relation("ReporterProfile")

  @@index([suspendedAt])
  @@index([joinedAt])
}

model DiscussionCategory {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  description String?
  icon        String       @default("✦")
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  discussions Discussion[]

  @@index([active, sortOrder])
}

model Discussion {
  id             String              @id @default(uuid())
  slug           String              @unique
  title          String
  body           String
  categoryId     String
  category       DiscussionCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorId       String?
  author         MemberProfile?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  pinned         Boolean             @default(false)
  locked         Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lastActivityAt DateTime            @default(now())
  deletedAt      DateTime?
  replies        DiscussionReply[]
  reports        CommunityReport[]

  @@index([categoryId, deletedAt, lastActivityAt])
  @@index([pinned, deletedAt, lastActivityAt])
  @@index([authorId, createdAt])
}

model DiscussionReply {
  id           String            @id @default(uuid())
  discussionId String
  discussion   Discussion        @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId     String?
  author       MemberProfile?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body         String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  editedAt     DateTime?
  deletedAt    DateTime?
  reports      CommunityReport[]

  @@index([discussionId, deletedAt, createdAt])
  @@index([authorId, createdAt])
}

model EncounterComment {
  id          String              @id @default(uuid())
  encounterId String
  encounter   Encounter           @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  authorId    String?
  author      MemberProfile?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      EncounterComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     EncounterComment[]  @relation("CommentReplies")
  body        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  editedAt    DateTime?
  deletedAt   DateTime?
  reports     CommunityReport[]

  @@index([encounterId, parentId, deletedAt, createdAt])
  @@index([authorId, createdAt])
}

model CommunityReport {
  id                  String                 @id @default(uuid())
  reporterId          String?
  reporter             MemberProfile?        @relation("ReporterProfile", fields: [reporterId], references: [id], onDelete: SetNull)
  reason               CommunityReportReason
  details              String?
  status               CommunityReportStatus @default(PENDING)
  discussionId         String?
  discussion           Discussion?           @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionReplyId    String?
  discussionReply      DiscussionReply?       @relation(fields: [discussionReplyId], references: [id], onDelete: Cascade)
  encounterCommentId   String?
  encounterComment     EncounterComment?      @relation(fields: [encounterCommentId], references: [id], onDelete: Cascade)
  createdAt            DateTime               @default(now())
  resolvedAt           DateTime?
  resolvedByAdminId    String?
  resolvedByAdmin      Administrator?         @relation("ResolvedReports", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  resolutionNote       String?

  @@index([status, createdAt])
  @@index([discussionId])
  @@index([discussionReplyId])
  @@index([encounterCommentId])
}

model CommunityModeration {
  id               String                       @id @default(uuid())
  administratorId  String
  administrator    Administrator                @relation(fields: [administratorId], references: [id], onDelete: Restrict)
  action           CommunityModerationAction
  targetType       CommunityTargetType
  targetId         String
  reason           String?
  metadata         Json?
  createdAt        DateTime                     @default(now())

  @@index([administratorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  strongAuthAt   DateTime?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([identifier])
  @@map("verification")
}
